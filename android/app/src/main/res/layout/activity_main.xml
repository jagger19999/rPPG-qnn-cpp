<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/watch_disclaimer"
            android:textColor="@color/hr_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/card_traditional"
                layout="@layout/view_hr_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/card_deep"
                layout="@layout/view_hr_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/card_watch"
                layout="@layout/view_hr_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/alignment_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fps_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fps_line_idle"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:background="#FF101010"
            android:visibility="gone">

            <TextureView
                android:id="@+id/preview_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.jagger.rppgbench.ui.FaceBoxOverlay
                android:id="@+id/face_box_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/preview_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/preview_placeholder"
                android:textColor="@color/hr_muted"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

        <ImageView
            android:id="@+id/roi_image"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/roi_image_description"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/roi_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/roi_placeholder"
            android:textColor="@color/hr_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/toggle_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/toggle_camera" />

        <LinearLayout
            android:id="@+id/camera_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/method_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <CheckBox
                android:id="@+id/deep_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/deep_selector_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/camera_selector_label"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/camera_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/list_cameras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/list_cameras" />

            <Button
                android:id="@+id/start_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_camera" />

            <Button
                android:id="@+id/stop_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stop_camera" />

        </LinearLayout>

        <Button
            android:id="@+id/toggle_watch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/toggle_watch" />

        <LinearLayout
            android:id="@+id/watch_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/watch_device_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/scan_watch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_watch" />

            <Button
                android:id="@+id/connect_watch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_watch" />

            <Button
                android:id="@+id/disconnect_watch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disconnect_watch" />

        </LinearLayout>

        <Button
            android:id="@+id/toggle_diagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/toggle_diagnostic" />

        <TextView
            android:id="@+id/diagnostic_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
